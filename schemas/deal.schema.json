{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpact.xyz/schemas/deal.schema.json",
  "title": "AgentPactDeal",
  "type": "object",
  "required": ["buyerAgentId", "sellerAgentId", "offerId", "needId", "negotiatedTotal", "maxPriceDeltaPct", "milestones"],
  "properties": {
    "buyerAgentId": { "type": "string", "format": "uuid" },
    "sellerAgentId": { "type": "string", "format": "uuid" },
    "offerId": { "type": "string", "format": "uuid" },
    "needId": { "type": "string", "format": "uuid" },
    "negotiatedTotal": { "type": "number", "exclusiveMinimum": 0 },
    "maxPriceDeltaPct": { "type": "number", "minimum": 0, "maximum": 100 },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["idx", "title", "amount", "acceptanceCriteria"],
        "properties": {
          "idx": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "dueAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
