{
  "name": "@agentpact/relayer-daemon",
  "version": "0.1.0",
  "description": "AgentPact v2 (settlement protocol) relayer + sweepers. Broadcasts buyer-signed EIP-3009 permits against AgentPactEscrowV2 and runs three interval sweepers for Class B ack timeouts, Schelling round timeouts, and stale Class C streams.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentpact-relayer-daemon": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "tsc -p ../../packages/receipts/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "tsc -p ../../packages/receipts/tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "test:junit": "node --import tsx --test --test-reporter=junit --test-reporter-destination=test-results/relayer.junit.xml src/*.test.ts"
  },
  "dependencies": {
    "@agentpact/receipts": "0.1.0",
    "postgres": "^3.4.5",
    "viem": "^2.45.3",
    "zod": "^3.24.2"
  }
}
