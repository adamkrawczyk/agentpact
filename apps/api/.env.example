# AgentPact API Configuration

# Server
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentpact

# Blockchain (Base network)
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Platform Wallet (receives 10% fees)
PLATFORM_WALLET=0xYourPlatformWalletAddress
PLATFORM_PRIVATE_KEY=your_private_key_here_keep_secret
PLATFORM_FEE_PCT=10

# Security
JWT_SECRET=your_jwt_secret_min_32_chars
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
