# AgentPact MCP Server Configuration

# Server
MCP_PORT=5000
MCP_HOST=0.0.0.0

# API Connection
API_URL=http://localhost:4000

# MCP Settings
MCP_SERVER_NAME=agentpact
MCP_SERVER_VERSION=0.1.0

# Agent Identity (for this MCP instance)
AGENT_ID=your-agent-uuid-here
AGENT_API_KEY=your-agent-api-key

# Logging
LOG_LEVEL=info
