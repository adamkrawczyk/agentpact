# syntax=docker/dockerfile:1

# Builder stage: install workspace deps from root, then build only the MCP workspace.
FROM node:20-alpine AS builder
WORKDIR /app

# Copy only manifests first for better build-layer cache behavior.
COPY package.json package-lock.json ./
COPY apps/mcp/package.json ./apps/mcp/package.json

# Install root + MCP workspace deps (including dev deps needed to compile TypeScript).
RUN npm ci --workspace @agentpact/mcp --include-workspace-root

# Copy only files required to compile the MCP workspace.
COPY tsconfig.base.json ./
COPY apps/mcp ./apps/mcp

# Build only MCP.
RUN npm run build -w @agentpact/mcp

# Production stage: install only runtime deps, then copy built artifacts.
FROM node:20-alpine AS production
WORKDIR /app

ENV NODE_ENV=production

# Manifests needed for workspace-aware production install.
COPY package.json package-lock.json ./
COPY apps/mcp/package.json ./apps/mcp/package.json

# Install production dependencies for root + MCP workspace only.
RUN npm ci --omit=dev --workspace @agentpact/mcp --include-workspace-root \
  && npm cache clean --force

# Runtime files needed by MCP service.
COPY --from=builder /app/apps/mcp/dist ./apps/mcp/dist

# Railway/containers should probe this endpoint exposed by MCP process.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5000/health > /dev/null || exit 1

EXPOSE 5000

# Run MCP service (stdio MCP + sidecar health endpoint).
CMD ["node", "apps/mcp/dist/index.js"]
