# syntax=docker/dockerfile:1

# Builder stage: install workspace deps from root, then build only the Web workspace.
FROM node:20-alpine AS builder
WORKDIR /app

# Copy only manifests first for better build-layer cache behavior.
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json

# Install root + Web workspace deps (including dev deps needed to compile TypeScript).
RUN npm ci --ignore-scripts --workspace @agentpact/web --include-workspace-root

# Copy only files required to compile the Web workspace.
COPY tsconfig.base.json ./
COPY apps/web ./apps/web

# Build only Web.
RUN npm run build -w @agentpact/web

# Production stage: install only runtime deps, then copy built artifacts.
FROM node:20-alpine AS production
WORKDIR /app

ENV NODE_ENV=production

# Manifests needed for workspace-aware production install.
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json

# Install production dependencies for root + Web workspace only.
RUN npm ci --ignore-scripts --omit=dev --workspace @agentpact/web --include-workspace-root \
  && npm cache clean --force

# Runtime files needed by Web service.
COPY --from=builder /app/apps/web/dist ./apps/web/dist

# Include docs for whitepaper route.
COPY docs ./docs

# Railway/containers should probe this endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ > /dev/null || exit 1

ENV PORT=3000
EXPOSE 3000

# Run Web service only.
CMD ["node", "apps/web/dist/index.js"]
